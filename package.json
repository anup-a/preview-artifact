{
  "name": "pretifact",
  "version": "0.1.4",
  "description": "Open AI-agent markdown / LaTeX / PDF artifacts in the browser — read beautifully, edit in place, save back, live-reload.",
  "type": "module",
  "homepage": "https://github.com/anup-a/preview-artifact",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anup-a/preview-artifact.git"
  },
  "bugs": {
    "url": "https://github.com/anup-a/preview-artifact/issues"
  },
  "keywords": [
    "markdown",
    "latex",
    "pdf",
    "viewer",
    "preview",
    "artifacts",
    "mermaid",
    "cli"
  ],
  "bin": {
    "pretifact": "bin/pretifact.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "prepare": "vite build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@fontsource/playfair-display": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@milkdown/core": "^7.21.1",
    "@milkdown/crepe": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.5",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.15.0",
    "open": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
